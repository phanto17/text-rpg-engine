{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RpgEngine content: background definitions",
  "allowComments": true,
  "allowTrailingCommas": true,
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "bonusSkill": {
        "type": "string"
      },
      "bonusGold": {
        "type": "integer"
      },
      "keepsakeItem": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "name",
      "description",
      "bonusSkill",
      "keepsakeItem"
    ],
    "additionalProperties": false
  }
}
