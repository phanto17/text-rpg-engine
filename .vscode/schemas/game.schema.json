{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RpgEngine content: game manifest",
  "allowComments": true,
  "allowTrailingCommas": true,
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "contentVersion": {
      "type": "string"
    },
    "startRoom": {
      "type": "string"
    },
    "intro": {
      "type": "string"
    },
    "startingGold": {
      "type": "integer"
    },
    "rules": {
      "type": "object",
      "properties": {
        "standardArray": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "proficiencyBonusByLevel": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "xpThresholdsByLevel": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "naturalCritsOnChecks": {
          "type": "boolean"
        },
        "monsterHp": {
          "enum": [
            "average",
            "roll"
          ]
        },
        "flee": {
          "type": "object",
          "properties": {
            "skill": {
              "type": [
                "string",
                "null"
              ]
            },
            "ability": {
              "enum": [
                "str",
                "dex",
                "con",
                "int",
                "wis",
                "cha",
                null
              ]
            },
            "dc": {
              "type": "integer"
            },
            "advantage": {
              "type": "boolean"
            },
            "disadvantage": {
              "type": "boolean"
            },
            "advantageIf": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "type"
                ],
                "anyOf": [
                  {
                    "properties": {
                      "type": {
                        "const": "flag"
                      },
                      "flag": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "flag"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "notFlag"
                      },
                      "flag": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "flag"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "hasItem"
                      },
                      "item": {
                        "type": "string"
                      },
                      "count": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "item"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "lacksItem"
                      },
                      "item": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "item"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "counter"
                      },
                      "counter": {
                        "type": "string"
                      },
                      "min": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "max": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "equals": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "counter"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "reputation"
                      },
                      "faction": {
                        "type": "string"
                      },
                      "min": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "max": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "faction"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "questStage"
                      },
                      "quest": {
                        "type": "string"
                      },
                      "min": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "max": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "equals": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "quest"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "class"
                      },
                      "class": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "class"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "background"
                      },
                      "background": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "background"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "abilityScore"
                      },
                      "ability": {
                        "enum": [
                          "str",
                          "dex",
                          "con",
                          "int",
                          "wis",
                          "cha"
                        ]
                      },
                      "min": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "ability",
                      "min"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "visited"
                      },
                      "room": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "room"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "all"
                      },
                      "conditions": {
                        "type": "array",
                        "items": {
                          "$ref": "#/properties/rules/properties/flee/properties/advantageIf/items"
                        }
                      }
                    },
                    "required": [
                      "conditions"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "any"
                      },
                      "conditions": {
                        "type": "array",
                        "items": {
                          "$ref": "#/properties/rules/properties/flee/properties/advantageIf/items"
                        }
                      }
                    },
                    "required": [
                      "conditions"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "not"
                      },
                      "conditions": {
                        "type": "array",
                        "items": {
                          "$ref": "#/properties/rules/properties/flee/properties/advantageIf/items"
                        }
                      }
                    },
                    "required": [
                      "conditions"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "disadvantageIf": {
              "type": "array",
              "items": {
                "$ref": "#/properties/rules/properties/flee/properties/advantageIf/items"
              }
            }
          },
          "required": [
            "dc"
          ],
          "additionalProperties": false
        },
        "defendStatus": {
          "type": "string"
        }
      },
      "required": [
        "standardArray",
        "proficiencyBonusByLevel",
        "flee",
        "defendStatus"
      ],
      "additionalProperties": false
    },
    "epilogues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "conditions": {
            "type": "array",
            "items": {
              "$ref": "#/properties/rules/properties/flee/properties/advantageIf/items"
            }
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    "gameOverText": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "contentVersion",
    "startRoom",
    "intro",
    "rules"
  ],
  "additionalProperties": false
}
