{
  "json.schemas": [
    {
      "fileMatch": [
        "/Data/game.json"
      ],
      "url": "./.vscode/schemas/game.schema.json"
    },
    {
      "fileMatch": [
        "/Data/Rules/classes.json"
      ],
      "url": "./.vscode/schemas/class.schema.json"
    },
    {
      "fileMatch": [
        "/Data/Rules/backgrounds.json"
      ],
      "url": "./.vscode/schemas/background.schema.json"
    },
    {
      "fileMatch": [
        "/Data/Rules/skills.json"
      ],
      "url": "./.vscode/schemas/skill.schema.json"
    },
    {
      "fileMatch": [
        "/Data/Rules/spells.json"
      ],
      "url": "./.vscode/schemas/spell.schema.json"
    },
    {
      "fileMatch": [
        "/Data/Rules/status_effects.json"
      ],
      "url": "./.vscode/schemas/status-effect.schema.json"
    },
    {
      "fileMatch": [
        "/Data/World/factions.json"
      ],
      "url": "./.vscode/schemas/faction.schema.json"
    },
    {
      "fileMatch": [
        "/Data/World/quests.json"
      ],
      "url": "./.vscode/schemas/quest.schema.json"
    },
    {
      "fileMatch": [
        "/Data/World/shops.json"
      ],
      "url": "./.vscode/schemas/shop.schema.json"
    },
    {
      "fileMatch": [
