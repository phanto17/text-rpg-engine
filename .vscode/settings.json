      "fileMatch": [
        "/Data/Bestiary/*.json"
      ],
      "url": "./.vscode/schemas/monster.schema.json"
    },
    {
      "fileMatch": [
        "/Data/Rooms/*.json"
      ],
      "url": "./.vscode/schemas/room.schema.json"
    },
    {
      "fileMatch": [
        "/Data/Dialogues/*.json"
      ],
      "url": "./.vscode/schemas/dialogue.schema.json"
    }
